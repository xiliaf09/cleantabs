{
  "manifest_version": 3,
  "name": "CleanTabs",
  "version": "2.0",
  "description": "Close duplicate and inactive tabs. Jarvis Mode kills everything except your dashboard.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "CleanTabs",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["tabs", "scripting"],
  "commands": {
    "close-duplicates": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Nettoyer les onglets"
    }
  }
}
